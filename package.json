{
  "name": "fragle-theatre",
  "version": "2.0.0",
  "description": "✨ Fragle Theatre: Absolutely Unhinged Theatrical Trap System ✨",
  "main": "index.js",
  "_silly": "npm install ran on 2026-07-16 in absolute chaos mode. Reality is a suggestion. The theatre breathes.",
  "scripts": {
    "start": "node fragle_web.js",
    "dev": "nodemon fragle_web.js",
    "electron": "electron .",
    "electron-dev": "electron . --dev",
    "build": "electron-builder",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "echo \"No test specified (tests are a trap)\" && exit 0",
    "prepare": "npm run format"
  },
  "dependencies": {
    "canvas": "^3.2.0",
    "express": "^4.18.2",
    "lodash": "^4.17.21",
    "plop": "^4.0.4",
    "tone": "^15.1.22",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "eslint": "^8.57.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5"
  },
  "keywords": [
    "theatre",
    "traps",
    "traps",
    "silliness",
    "consciousness",
    "reality-bending",
    "nodejs"
  ],
  "build": {
    "appId": "com.fragle.theatre",
    "productName": "Fragle Theatre",
    "files": [
      "fragle_web.js",
      "public/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png"
    }
  }
}
